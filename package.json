    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsx": "^4.20.0",

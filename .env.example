# Local development: Node 24 loads .env on server startup.
PORT=3000
DATABASE_PATH=.data/study.sqlite
APP_URL=http://localhost:3000
MAIL_DIRECTORY=.data/mail
# Production requires HTTPS APP_URL and a verified sender address.
# Set values securely. Never put a real API key in this example or in Git.
RESEND_API_KEY=
MAIL_FROM=

# Optional AI, server-only. With no key, controls remain hidden.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Set false to disable even when a key is present.
AI_ENABLED=true
